// Zeebroo — simple website built with Melt.
// Run from project root: ./build/melt zeebroo-website/main.melt
// Open http://localhost:8788

import "config/app.melt";
import "routes.melt";

class App {
    method handle() {
        let pathFull = getRequestPath();
        let pathParts = splitString(pathFull, "?");
        let path = arrayGet(pathParts, 0);
        Router().dispatch(path);
    }
}

setHandler("App");
print "Zeebroo website: http://localhost:" + app.port;
print "  /  Home   /about   /contact";
listen(app.port);
