import "controllers/home_controller.melt";
import "controllers/about_controller.melt";
import "controllers/industry_controller.melt";
import "controllers/download_controller.melt";
import "controllers/api_controller.melt";
import "controllers/admin_controller.melt";
import "controllers/not_found_controller.melt";

class Router {
    method dispatch(path) {
        if (servePublic(path)) return;
        let pathParts = splitString(path, "?");
        let cleanPath = arrayGet(pathParts, 0);
        let parts = splitString(cleanPath, "/");
        let seg1 = arrayGet(parts, 1);
        if (cleanPath == "/" || cleanPath == "/index") {
            HomeController().index();
        } else if (cleanPath == "/about") {
            AboutController().index();
        } else if (cleanPath == "/download") {
            DownloadController().index();
        } else if (cleanPath == "/api/releases") {
            ApiController().publishRelease();
        } else if (seg1 == "admin") {
            AdminController().dispatch(path);
        } else if (seg1 == "industry") {
            IndustryController().show(path);
        } else {
            NotFoundController().show(path);
        }
    }
}
