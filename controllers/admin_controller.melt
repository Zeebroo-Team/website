import "../config/db.melt";
import "../config/admin.melt";

class AdminController {

    method esc(val) {
        return replaceString(val + "", "'", "''");
    }

    method he(val) {
        let s = replaceString(val + "", "&", "&amp;");
        s = replaceString(s, "<", "&lt;");
        s = replaceString(s, ">", "&gt;");
        s = replaceString(s, "\"", "&quot;");
        return s;
    }

    method getCookie(name) {
        let raw = getRequestHeader("Cookie");
        if (raw == "") { return ""; }
        let parts = splitString(raw, ";");
        let i = 0;
        while (i < arrayLength(parts)) {
            let part = arrayGet(parts, i);
            let kv = splitString(part, "=");
            if (arrayLength(kv) >= 2) {
                let k = replaceString(arrayGet(kv, 0), " ", "");
                if (k == name) { return arrayGet(kv, 1); }
            }
            i = i + 1;
        }
        return "";
    }

    method isLoggedIn() {
        return this.getCookie(adminCfg.cookieName) == adminCfg.sessionToken;
    }

    method redirect(url) {
        setResponseStatus(302);
        setResponseHeader("Location", url);
        setResponseContentType("text/html; charset=utf-8");
        setResponseBody("");
    }

    method jsonOk() {
        let o = objectCreate();
        o.ok = true;
        setResponseStatus(200);
        setResponseContentType("application/json; charset=utf-8");
        setResponseBody(jsonEncode(o));
    }

    method jsonErr(status, msg) {
        let o = objectCreate();
        o.ok = false;
        o.error = msg;
        setResponseStatus(status);
        setResponseContentType("application/json; charset=utf-8");
        setResponseBody(jsonEncode(o));
    }

    method postParam(body, name) {
        let params = splitString(body, "&");
        let i = 0;
        while (i < arrayLength(params)) {
            let kv = splitString(arrayGet(params, i), "=");
            if (arrayLength(kv) >= 2) {
                if (arrayGet(kv, 0) == name) {
                    return replaceString(arrayGet(kv, 1), "+", " ");
                }
            }
            i = i + 1;
        }
        return "";
    }

    method queryParam(path, name) {
        let qp = splitString(path, "?");
        if (arrayLength(qp) < 2) { return ""; }
        let pairs = splitString(arrayGet(qp, 1), "&");
        let i = 0;
        while (i < arrayLength(pairs)) {
            let kv = splitString(arrayGet(pairs, i), "=");
            if (arrayLength(kv) >= 2 && arrayGet(kv, 0) == name) {
                return arrayGet(kv, 1);
            }
            i = i + 1;
        }
        return "";
    }

    method field(obj, name, fallback) {
        let raw = obj[name];
        if (raw == false) { return fallback; }
        let val = raw + "";
        if (val == "" || val == "null") { return fallback; }
        return val;
    }

    method notesFromArray(obj) {
        let result = "";
        try {
            let arr = obj["notes"];
            let n = arrayLength(arr);
            let i = 0;
            while (i < n) {
                let line = arrayGet(arr, i) + "";
                if (line != "" && line != "null") {
                    if (result != "") { result = result + "|"; }
                    result = result + line;
                }
                i = i + 1;
            }
        } catch (e) { result = ""; }
        return result;
    }

    method semverDesc() {
        return "CAST(SUBSTR(version,1,INSTR(version||'.','.') - 1) AS INTEGER) DESC, CAST(SUBSTR(SUBSTR(version,INSTR(version||'.','.') + 1),1,INSTR(SUBSTR(version,INSTR(version||'.','.') + 1)||'.','.')-1) AS INTEGER) DESC, CAST(SUBSTR(SUBSTR(version,INSTR(version||'.','.') + 1),INSTR(SUBSTR(version,INSTR(version||'.','.') + 1)||'.','.')+1) AS INTEGER) DESC";
    }

    // Read a setting from DB, falling back to the config default
    method getSetting(key, fallback) {
        let result = fallback;
        let db = DB();
        if (db.open()) {
            db.ensureSettings();
            if (sqliteQuery("SELECT value FROM settings WHERE key='" + this.esc(key) + "' LIMIT 1")) {
                let rows = sqliteFetchAll();
                if (arrayLength(rows) > 0) {
                    let row = arrayGet(rows, 0);
                    result = arrayGet(row, 0);
                }
            }
            db.close();
        }
        return result;
    }

    method setSetting(key, value) {
        let ok = false;
        let db = DB();
        if (db.open()) {
            db.ensureSettings();
            ok = sqliteExec("INSERT OR REPLACE INTO settings (key, value) VALUES ('" + this.esc(key) + "','" + this.esc(value) + "')");
            db.close();
        }
        return ok;
    }

    // Wraps content in the admin chrome
    method page(title, body) {
        let h = "<!DOCTYPE html><html lang=\"en\"><head>";
        h = h + "<meta charset=\"utf-8\">";
        h = h + "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">";
        h = h + "<title>" + title + " - Zeebroo Admin</title>";
        h = h + "<link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">";
        h = h + "<link rel=\"stylesheet\" href=\"/css/admin.css\">";
        h = h + "</head><body>";
        h = h + "<aside class=\"adm-sidebar\">";
        h = h + "<div class=\"adm-sidebar__top\">";
        h = h + "<a class=\"adm-brand\" href=\"/admin\"><span class=\"adm-brand__z\">Z</span><span class=\"adm-brand__name\">Admin</span></a>";
        h = h + "</div>";
        h = h + "<nav class=\"adm-sidebar__nav\">";
        h = h + "<p class=\"adm-sidebar__section\">Manage</p>";
        h = h + "<a href=\"/admin/releases\" class=\"adm-sidebar__link\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M2 4h12M2 8h8M2 12h10\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg> Releases</a>";
        h = h + "<a href=\"/admin/blog\" class=\"adm-sidebar__link\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><rect x=\"2\" y=\"2\" width=\"12\" height=\"12\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M5 6h6M5 9h4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Blog</a>";
        h = h + "<p class=\"adm-sidebar__section\">Account</p>";
        h = h + "<a href=\"/admin/settings\" class=\"adm-sidebar__link\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><circle cx=\"8\" cy=\"8\" r=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.42 1.42M11.53 11.53l1.42 1.42M3.05 12.95l1.42-1.42M11.53 4.47l1.42-1.42\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Settings</a>";
        h = h + "</nav>";
        h = h + "<div class=\"adm-sidebar__bottom\">";
        h = h + "<a href=\"/\" target=\"_blank\" class=\"adm-sidebar__link adm-sidebar__link--muted\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M6 2H3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-3\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><path d=\"M9 2h5v5M14 2l-6 6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg> View Site</a>";
        h = h + "<a href=\"/admin/logout\" class=\"adm-sidebar__link adm-sidebar__link--danger\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M6 2H3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3M10 11l3-3-3-3M13 8H6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg> Logout</a>";
        h = h + "</div>";
        h = h + "</aside>";
        h = h + "<div class=\"adm-layout\">";
        h = h + "<header class=\"adm-topbar\">";
        h = h + "<h2 class=\"adm-topbar__title\">" + title + "</h2>";
        h = h + "<div class=\"adm-topbar__right\">";
        h = h + "<a href=\"/admin/releases/new\" class=\"adm-btn adm-btn--primary adm-btn--sm\">+ New Release</a>";
        h = h + "</div>";
        h = h + "</header>";
        h = h + "<main class=\"adm-main\">" + body + "</main>";
        h = h + "</div>";
        h = h + "</body></html>";
        setResponseStatus(200);
        setResponseContentType("text/html; charset=utf-8");
        setResponseBody(h);
    }

    // Standalone login page (no nav)
    method loginPage(errorMsg) {
        let errHtml = "";
        if (errorMsg != "") {
            errHtml = "<div class=\"adm-alert adm-alert--error\">" + this.he(errorMsg) + "</div>";
        }
        let h = "<!DOCTYPE html><html lang=\"en\"><head>";
        h = h + "<meta charset=\"utf-8\">";
        h = h + "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">";
        h = h + "<title>Admin Login - Zeebroo</title>";
        h = h + "<link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">";
        h = h + "<link rel=\"stylesheet\" href=\"/css/admin.css\">";
        h = h + "</head><body class=\"adm-login-bg\">";
        h = h + "<div class=\"adm-login\">";
        h = h + "<div class=\"adm-login__mark\"><span>Z</span></div>";
        h = h + "<h1 class=\"adm-login__title\">Zeebroo Admin</h1>";
        h = h + "<p class=\"adm-login__sub\">Sign in to manage releases</p>";
        h = h + errHtml;
        h = h + "<form method=\"POST\" action=\"/admin/login\" class=\"adm-form\">";
        h = h + "<div class=\"adm-field\"><label>Username</label><input type=\"text\" name=\"username\" autocomplete=\"username\" autofocus required></div>";
        h = h + "<div class=\"adm-field\"><label>Password</label><input type=\"password\" name=\"password\" autocomplete=\"current-password\" required></div>";
        h = h + "<button type=\"submit\" class=\"adm-btn adm-btn--primary adm-btn--full\">Sign in</button>";
        h = h + "</form>";
        h = h + "</div>";
        h = h + "</body></html>";
        setResponseStatus(200);
        setResponseContentType("text/html; charset=utf-8");
        setResponseBody(h);
    }

    method login(path) {
        if (getRequestMethod() == "POST") {
            let b = getRequestBody();
            let u = this.postParam(b, "username");
            let p = this.postParam(b, "password");
            let storedUser = this.getSetting("admin_username", adminCfg.username);
            let storedPass = this.getSetting("admin_password", adminCfg.password);
            if (u == storedUser && p == storedPass) {
                setResponseHeader("Set-Cookie", adminCfg.cookieName + "=" + adminCfg.sessionToken + "; Path=/; HttpOnly; SameSite=Lax");
                this.redirect("/admin");
            } else {
                this.loginPage("Invalid username or password.");
            }
        } else {
            if (this.isLoggedIn()) {
                this.redirect("/admin");
            } else {
                this.loginPage("");
            }
        }
    }

    method logout() {
        setResponseHeader("Set-Cookie", adminCfg.cookieName + "=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0");
        this.redirect("/admin/login");
    }

    method releases(path) {
        let db = DB();
        let rows = "";
        let count = "0";

        if (db.open()) {
            if (sqliteQuery("SELECT id, version, release_date, channel, windows_url, macos_url, linux_url FROM releases ORDER BY " + this.semverDesc())) {
                let data = sqliteFetchAll();
                count = arrayLength(data) + "";
                let ri = 0;
                while (ri < arrayLength(data)) {
                    let row = arrayGet(data, ri);
                    let id      = arrayGet(row, 0);
                    let ver     = arrayGet(row, 1);
                    let date    = arrayGet(row, 2);
                    let channel = arrayGet(row, 3);
                    let hasWin  = arrayGet(row, 4) != "";
                    let hasMac  = arrayGet(row, 5) != "";
                    let hasLin  = arrayGet(row, 6) != "";

                    let badge = "<span class=\"adm-badge adm-badge--stable\">stable</span>";
                    if (channel == "beta") { badge = "<span class=\"adm-badge adm-badge--beta\">beta</span>"; }

                    let dots = "";
                    if (hasWin) { dots = dots + "<span class=\"adm-dot adm-dot--win\" title=\"Windows\">Win</span>"; }
                    if (hasMac) { dots = dots + "<span class=\"adm-dot adm-dot--mac\" title=\"macOS\">Mac</span>"; }
                    if (hasLin) { dots = dots + "<span class=\"adm-dot adm-dot--lin\" title=\"Linux\">Linux</span>"; }
                    if (dots == "") { dots = "<span class=\"adm-dot adm-dot--none\">No URLs</span>"; }

                    let latestTag = "";
                    if (ri == 0) { latestTag = "<span class=\"adm-latest\">Latest</span>"; }

                    rows = rows + "<tr>";
                    rows = rows + "<td><span class=\"adm-ver\">v" + this.he(ver) + "</span>" + latestTag + "</td>";
                    rows = rows + "<td>" + this.he(date) + "</td>";
                    rows = rows + "<td>" + badge + "</td>";
                    rows = rows + "<td><div class=\"adm-dots\">" + dots + "</div></td>";
                    rows = rows + "<td><div class=\"adm-actions\">";
                    rows = rows + "<a href=\"/admin/releases/edit?id=" + id + "\" class=\"adm-btn adm-btn--sm\">Edit</a> ";
                    rows = rows + "<button type=\"button\" onclick=\"confirmDelete(" + id + ",'v" + this.he(ver) + "')\" class=\"adm-btn adm-btn--sm adm-btn--danger\">Delete</button>";
                    rows = rows + "</div></td>";
                    rows = rows + "</tr>";
                    ri = ri + 1;
                }
            }
            db.close();
        }

        let emptyMsg = "";
        if (count == "0") {
            emptyMsg = "<tr><td colspan=\"5\" class=\"adm-empty\">No releases yet. <a href=\"/admin/releases/new\">Create the first one.</a></td></tr>";
        }

        let body = "";
        body = body + "<div class=\"adm-page-hdr\">";
        body = body + "<div><h1>Releases</h1><p class=\"adm-sub\">" + count + " total</p></div>";
        body = body + "<a href=\"/admin/releases/new\" class=\"adm-btn adm-btn--primary\">+ New Release</a>";
        body = body + "</div>";
        body = body + "<div class=\"adm-card\">";
        body = body + "<table class=\"adm-table\">";
        body = body + "<thead><tr><th>Version</th><th>Release Date</th><th>Channel</th><th>Platforms</th><th>Actions</th></tr></thead>";
        body = body + "<tbody>" + rows + emptyMsg + "</tbody>";
        body = body + "</table></div>";

        // Delete modal
        body = body + "<div class=\"adm-overlay\" id=\"delOverlay\" onclick=\"closeModal()\"></div>";
        body = body + "<div class=\"adm-modal\" id=\"delModal\">";
        body = body + "<h2>Delete release?</h2>";
        body = body + "<p id=\"delMsg\" class=\"adm-modal__msg\"></p>";
        body = body + "<div class=\"adm-modal__btns\">";
        body = body + "<button onclick=\"closeModal()\" class=\"adm-btn\">Cancel</button>";
        body = body + "<form id=\"delForm\" method=\"POST\" action=\"/admin/releases/delete\" style=\"display:inline\">";
        body = body + "<input type=\"hidden\" name=\"id\" id=\"delId\">";
        body = body + "<button type=\"submit\" class=\"adm-btn adm-btn--danger\">Yes, delete</button>";
        body = body + "</form></div></div>";

        body = body + "<script>";
        body = body + "function confirmDelete(id,ver){";
        body = body + "document.getElementById('delId').value=id;";
        body = body + "document.getElementById('delMsg').textContent='Permanently delete '+ver+'? This cannot be undone.';";
        body = body + "document.getElementById('delOverlay').style.display='block';";
        body = body + "document.getElementById('delModal').style.display='block';}";
        body = body + "function closeModal(){";
        body = body + "document.getElementById('delOverlay').style.display='none';";
        body = body + "document.getElementById('delModal').style.display='none';}";
        body = body + "</script>";

        this.page("Releases", body);
    }

    method renderForm(isEdit, id, version, date, channel, notesRaw, winUrl, macUrl, linUrl) {
        let notesDisplay = replaceString(notesRaw, "|", "\n");
        let idField = "";
        if (isEdit) {
            idField = "<input type=\"hidden\" id=\"releaseId\" value=\"" + this.he(id) + "\">";
        }
        let selStable = "selected";
        let selBeta = "";
        if (channel == "beta") { selStable = ""; selBeta = "selected"; }

        let titleText = "New Release";
        if (isEdit) { titleText = "Edit Release"; }

        let body = "";
        body = body + "<div class=\"adm-page-hdr\">";
        body = body + "<div><h1>" + titleText + "</h1></div>";
        body = body + "<a href=\"/admin/releases\" class=\"adm-btn\">&larr; Back</a>";
        body = body + "</div>";
        body = body + "<div class=\"adm-card adm-card--form\">";
        body = body + "<form id=\"rForm\">";
        body = body + idField;

        body = body + "<div class=\"adm-form-row\">";
        body = body + "<div class=\"adm-field\"><label>Version <span class=\"adm-req\">*</span></label>";
        body = body + "<input type=\"text\" id=\"fVersion\" placeholder=\"1.0.0\" value=\"" + this.he(version) + "\" required></div>";
        body = body + "<div class=\"adm-field\"><label>Release Date <span class=\"adm-req\">*</span></label>";
        body = body + "<input type=\"date\" id=\"fDate\" value=\"" + this.he(date) + "\" required></div>";
        body = body + "<div class=\"adm-field\"><label>Channel</label>";
        body = body + "<select id=\"fChannel\"><option value=\"stable\" " + selStable + ">Stable</option><option value=\"beta\" " + selBeta + ">Beta</option></select></div>";
        body = body + "</div>";

        body = body + "<div class=\"adm-field\"><label>Release Notes <small>one per line</small></label>";
        body = body + "<textarea id=\"fNotes\" rows=\"5\" placeholder=\"Fixed login bug&#10;Added export feature\">" + this.he(notesDisplay) + "</textarea></div>";

        body = body + "<div class=\"adm-section-label\">Download URLs</div>";
        body = body + "<div class=\"adm-field\"><label>Windows URL</label>";
        body = body + "<input type=\"url\" id=\"fWin\" placeholder=\"https://\" value=\"" + this.he(winUrl) + "\"></div>";
        body = body + "<div class=\"adm-field\"><label>macOS URL</label>";
        body = body + "<input type=\"url\" id=\"fMac\" placeholder=\"https://\" value=\"" + this.he(macUrl) + "\"></div>";
        body = body + "<div class=\"adm-field\"><label>Linux URL</label>";
        body = body + "<input type=\"url\" id=\"fLin\" placeholder=\"https://\" value=\"" + this.he(linUrl) + "\"></div>";

        body = body + "<div class=\"adm-form-footer\">";
        body = body + "<div id=\"fMsg\" class=\"adm-alert\" style=\"display:none\"></div>";
        body = body + "<button type=\"submit\" id=\"fBtn\" class=\"adm-btn adm-btn--primary\">Save Release</button>";
        body = body + "</div>";
        body = body + "</form></div>";

        body = body + "<script>";
        body = body + "document.getElementById('rForm').addEventListener('submit',async function(e){";
        body = body + "e.preventDefault();";
        body = body + "var btn=document.getElementById('fBtn');";
        body = body + "var msg=document.getElementById('fMsg');";
        body = body + "btn.disabled=true;btn.textContent='Saving...';";
        body = body + "var idEl=document.getElementById('releaseId');";
        body = body + "var notesArr=document.getElementById('fNotes').value.split('\\n').map(function(l){return l.trim();}).filter(function(l){return l!=='';});";
        body = body + "var data={";
        body = body + "version:document.getElementById('fVersion').value.trim(),";
        body = body + "release_date:document.getElementById('fDate').value,";
        body = body + "channel:document.getElementById('fChannel').value,";
        body = body + "notes:notesArr,";
        body = body + "windows_url:document.getElementById('fWin').value.trim(),";
        body = body + "macos_url:document.getElementById('fMac').value.trim(),";
        body = body + "linux_url:document.getElementById('fLin').value.trim()";
        body = body + "};";
        body = body + "var endpoint='/admin/releases/create';";
        body = body + "if(idEl){data.id=idEl.value;endpoint='/admin/releases/update';}";
        body = body + "try{";
        body = body + "var r=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});";
        body = body + "var j=await r.json();";
        body = body + "if(j.ok){window.location.href='/admin/releases';}";
        body = body + "else{msg.style.display='block';msg.className='adm-alert adm-alert--error';msg.textContent=j.error||'Save failed.';btn.disabled=false;btn.textContent='Save Release';}";
        body = body + "}catch(err){msg.style.display='block';msg.className='adm-alert adm-alert--error';msg.textContent='Network error. Try again.';btn.disabled=false;btn.textContent='Save Release';}";
        body = body + "});";
        body = body + "</script>";

        return body;
    }

    method releaseNew(path) {
        let body = this.renderForm(false, "", "", "", "stable", "", "", "", "");
        this.page("New Release", body);
    }

    method releaseEdit(path) {
        let id = this.queryParam(path, "id");
        if (id == "") { this.redirect("/admin/releases"); return; }

        let db = DB();
        let found = false;
        let ver = ""; let date = ""; let channel = ""; let notes = "";
        let winUrl = ""; let macUrl = ""; let linUrl = "";

        if (db.open()) {
            if (sqliteQuery("SELECT id, version, release_date, channel, notes, windows_url, macos_url, linux_url FROM releases WHERE id = " + this.esc(id) + " LIMIT 1")) {
                let rows = sqliteFetchAll();
                if (arrayLength(rows) > 0) {
                    let row = arrayGet(rows, 0);
                    found   = true;
                    id      = arrayGet(row, 0);
                    ver     = arrayGet(row, 1);
                    date    = arrayGet(row, 2);
                    channel = arrayGet(row, 3);
                    notes   = arrayGet(row, 4);
                    winUrl  = arrayGet(row, 5);
                    macUrl  = arrayGet(row, 6);
                    linUrl  = arrayGet(row, 7);
                }
            }
            db.close();
        }

        if (!found) { this.redirect("/admin/releases"); return; }

        let body = this.renderForm(true, id, ver, date, channel, notes, winUrl, macUrl, linUrl);
        this.page("Edit Release", body);
    }

    method releaseCreate(path) {
        if (!this.isLoggedIn()) { this.jsonErr(401, "Unauthorized"); return; }
        if (getRequestMethod() != "POST") { this.jsonErr(405, "POST required"); return; }

        let data    = jsonDecode(getRequestBody());
        let version = this.field(data, "version", "");
        let date    = this.field(data, "release_date", "");
        if (version == "") { this.jsonErr(400, "Version is required"); return; }
        if (date == "") { this.jsonErr(400, "Release date is required"); return; }

        let channel = this.field(data, "channel", "stable");
        let winUrl  = this.field(data, "windows_url", "");
        let macUrl  = this.field(data, "macos_url", "");
        let linUrl  = this.field(data, "linux_url", "");
        let notes   = this.notesFromArray(data);
        if (notes == "") { notes = this.field(data, "notes", ""); }

        let db = DB();
        if (!db.open()) { this.jsonErr(500, "Database unavailable"); return; }

        let sql = "INSERT OR REPLACE INTO releases (version, release_date, channel, notes, windows_url, macos_url, linux_url) VALUES ('" +
            this.esc(version) + "','" + this.esc(date) + "','" + this.esc(channel) + "','" +
            this.esc(notes) + "','" + this.esc(winUrl) + "','" + this.esc(macUrl) + "','" + this.esc(linUrl) + "')";

        let ok = sqliteExec(sql);
        db.close();

        if (!ok) { this.jsonErr(500, "Failed to save release"); return; }
        this.jsonOk();
    }

    method releaseUpdate(path) {
        if (!this.isLoggedIn()) { this.jsonErr(401, "Unauthorized"); return; }
        if (getRequestMethod() != "POST") { this.jsonErr(405, "POST required"); return; }

        let data    = jsonDecode(getRequestBody());
        let id      = this.field(data, "id", "");
        let version = this.field(data, "version", "");
        let date    = this.field(data, "release_date", "");
        if (id == "")      { this.jsonErr(400, "ID is required"); return; }
        if (version == "") { this.jsonErr(400, "Version is required"); return; }
        if (date == "")    { this.jsonErr(400, "Release date is required"); return; }

        let channel = this.field(data, "channel", "stable");
        let winUrl  = this.field(data, "windows_url", "");
        let macUrl  = this.field(data, "macos_url", "");
        let linUrl  = this.field(data, "linux_url", "");
        let notes   = this.notesFromArray(data);
        if (notes == "") { notes = this.field(data, "notes", ""); }

        let db = DB();
        if (!db.open()) { this.jsonErr(500, "Database unavailable"); return; }

        let sql = "UPDATE releases SET version='" + this.esc(version) + "', release_date='" + this.esc(date) +
            "', channel='" + this.esc(channel) + "', notes='" + this.esc(notes) +
            "', windows_url='" + this.esc(winUrl) + "', macos_url='" + this.esc(macUrl) +
            "', linux_url='" + this.esc(linUrl) + "' WHERE id=" + this.esc(id);

        let ok = sqliteExec(sql);
        db.close();

        if (!ok) { this.jsonErr(500, "Failed to update release"); return; }
        this.jsonOk();
    }

    method releaseDelete(path) {
        if (getRequestMethod() != "POST") { this.redirect("/admin/releases"); return; }
        let id = this.postParam(getRequestBody(), "id");
        if (id == "") { this.redirect("/admin/releases"); return; }

        let db = DB();
        if (db.open()) {
            sqliteExec("DELETE FROM releases WHERE id=" + this.esc(id));
            db.close();
        }
        this.redirect("/admin/releases");
    }

    // ── Blog admin ────────────────────────────────────────────────── //

    method blogList(path) {
        let db = DB();
        let rows = "";
        let count = "0";

        if (db.open()) {
            db.ensurePosts();
            if (sqliteQuery("SELECT id, title, slug, status, published_at FROM posts ORDER BY id DESC")) {
                let data = sqliteFetchAll();
                count = arrayLength(data) + "";
                let ri = 0;
                while (ri < arrayLength(data)) {
                    let row    = arrayGet(data, ri);
                    let id     = arrayGet(row, 0);
                    let title  = arrayGet(row, 1);
                    let slug   = arrayGet(row, 2);
                    let status = arrayGet(row, 3);
                    let pubAt  = arrayGet(row, 4);

                    let badge = "<span class=\"adm-badge adm-badge--draft\">draft</span>";
                    if (status == "published") { badge = "<span class=\"adm-badge adm-badge--stable\">published</span>"; }

                    rows = rows + "<tr>";
                    rows = rows + "<td><span class=\"adm-post-title\">" + this.he(title) + "</span></td>";
                    rows = rows + "<td><code class=\"adm-slug\">" + this.he(slug) + "</code></td>";
                    rows = rows + "<td>" + badge + "</td>";
                    rows = rows + "<td>" + this.he(pubAt) + "</td>";
                    rows = rows + "<td><div class=\"adm-actions\">";
                    rows = rows + "<a href=\"/blog/" + this.he(slug) + "\" target=\"_blank\" class=\"adm-btn adm-btn--sm\">View</a> ";
                    rows = rows + "<a href=\"/admin/blog/edit?id=" + id + "\" class=\"adm-btn adm-btn--sm\">Edit</a> ";
                    rows = rows + "<button type=\"button\" onclick=\"confirmDeletePost(" + id + ",'" + this.he(title) + "')\" class=\"adm-btn adm-btn--sm adm-btn--danger\">Delete</button>";
                    rows = rows + "</div></td>";
                    rows = rows + "</tr>";
                    ri = ri + 1;
                }
            }
            db.close();
        }

        let emptyMsg = "";
        if (count == "0") {
            emptyMsg = "<tr><td colspan=\"5\" class=\"adm-empty\">No posts yet. <a href=\"/admin/blog/new\">Write the first one.</a></td></tr>";
        }

        let body = "";
        body = body + "<div class=\"adm-page-hdr\"><div><h1>Blog</h1><p class=\"adm-sub\">" + count + " posts</p></div>";
        body = body + "<a href=\"/admin/blog/new\" class=\"adm-btn adm-btn--primary\">+ New Post</a></div>";
        body = body + "<div class=\"adm-card\">";
        body = body + "<table class=\"adm-table\">";
        body = body + "<thead><tr><th>Title</th><th>Slug</th><th>Status</th><th>Published</th><th>Actions</th></tr></thead>";
        body = body + "<tbody>" + rows + emptyMsg + "</tbody>";
        body = body + "</table></div>";

        body = body + "<div class=\"adm-overlay\" id=\"delPostOverlay\" onclick=\"closePostModal()\"></div>";
        body = body + "<div class=\"adm-modal\" id=\"delPostModal\">";
        body = body + "<h2>Delete post?</h2><p id=\"delPostMsg\" class=\"adm-modal__msg\"></p>";
        body = body + "<div class=\"adm-modal__btns\"><button onclick=\"closePostModal()\" class=\"adm-btn\">Cancel</button>";
        body = body + "<form id=\"delPostForm\" method=\"POST\" action=\"/admin/blog/delete\" style=\"display:inline\">";
        body = body + "<input type=\"hidden\" name=\"id\" id=\"delPostId\">";
        body = body + "<button type=\"submit\" class=\"adm-btn adm-btn--danger\">Yes, delete</button>";
        body = body + "</form></div></div>";

        body = body + "<script>";
        body = body + "function confirmDeletePost(id,title){";
        body = body + "document.getElementById('delPostId').value=id;";
        body = body + "document.getElementById('delPostMsg').textContent='Permanently delete \"'+title+'\"? This cannot be undone.';";
        body = body + "document.getElementById('delPostOverlay').style.display='block';";
        body = body + "document.getElementById('delPostModal').style.display='block';}";
        body = body + "function closePostModal(){";
        body = body + "document.getElementById('delPostOverlay').style.display='none';";
        body = body + "document.getElementById('delPostModal').style.display='none';}";
        body = body + "</script>";

        this.page("Blog", body);
    }

    method blogForm(isEdit, id, title, slug, excerpt, content, status, pubAt) {
        let selDraft = "selected"; let selPub = "";
        if (status == "published") { selDraft = ""; selPub = "selected"; }
        let idField = "";
        if (isEdit) { idField = "<input type=\"hidden\" id=\"postId\" value=\"" + this.he(id) + "\">"; }
        let titleText = "New Post";
        if (isEdit) { titleText = "Edit Post"; }

        let body = "";
        body = body + "<div class=\"adm-page-hdr\"><div><h1>" + titleText + "</h1></div><a href=\"/admin/blog\" class=\"adm-btn\">&larr; Back</a></div>";
        body = body + "<div class=\"adm-card adm-card--form\"><form id=\"pForm\" class=\"adm-form\">";
        body = body + idField;
        body = body + "<div class=\"adm-form-row\">";
        body = body + "<div class=\"adm-field\" style=\"grid-column:span 2\"><label>Title <span class=\"adm-req\">*</span></label>";
        body = body + "<input type=\"text\" id=\"pTitle\" value=\"" + this.he(title) + "\" placeholder=\"My awesome post\" required></div>";
        body = body + "<div class=\"adm-field\"><label>Status</label>";
        body = body + "<select id=\"pStatus\"><option value=\"draft\" " + selDraft + ">Draft</option><option value=\"published\" " + selPub + ">Published</option></select></div>";
        body = body + "</div>";
        body = body + "<div class=\"adm-field\"><label>Slug <span class=\"adm-req\">*</span> <small>URL: /blog/your-slug</small></label>";
        body = body + "<input type=\"text\" id=\"pSlug\" value=\"" + this.he(slug) + "\" placeholder=\"my-awesome-post\" required></div>";
        body = body + "<div class=\"adm-field\"><label>Excerpt <small>short description shown in listing</small></label>";
        body = body + "<textarea id=\"pExcerpt\" rows=\"2\" placeholder=\"A short summary...\">" + this.he(excerpt) + "</textarea></div>";
        body = body + "<div class=\"adm-field\"><label>Content <small>HTML supported</small></label>";
        body = body + "<textarea id=\"pContent\" rows=\"18\" placeholder=\"&lt;p&gt;Write your post here...&lt;/p&gt;\" class=\"adm-content-editor\">" + this.he(content) + "</textarea></div>";
        body = body + "<div class=\"adm-form-footer\">";
        body = body + "<div id=\"pMsg\" class=\"adm-alert\" style=\"display:none\"></div>";
        body = body + "<button type=\"submit\" id=\"pBtn\" class=\"adm-btn adm-btn--primary\">Save Post</button>";
        body = body + "</div></form></div>";

        body = body + "<script>";
        body = body + "var titleEl=document.getElementById('pTitle');";
        body = body + "var slugEl=document.getElementById('pSlug');";
        body = body + "function toSlug(s){return s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');}";
        body = body + "titleEl.addEventListener('input',function(){if(!slugEl.dataset.manual){slugEl.value=toSlug(titleEl.value);}});";
        body = body + "slugEl.addEventListener('input',function(){slugEl.dataset.manual='1';});";
        body = body + "document.getElementById('pForm').addEventListener('submit',async function(e){";
        body = body + "e.preventDefault();";
        body = body + "var btn=document.getElementById('pBtn');var msg=document.getElementById('pMsg');";
        body = body + "btn.disabled=true;btn.textContent='Saving...';";
        body = body + "var idEl=document.getElementById('postId');";
        body = body + "var data={title:titleEl.value.trim(),slug:slugEl.value.trim(),excerpt:document.getElementById('pExcerpt').value.trim(),content:document.getElementById('pContent').value,status:document.getElementById('pStatus').value};";
        body = body + "var endpoint='/admin/blog/create';";
        body = body + "if(idEl){data.id=idEl.value;endpoint='/admin/blog/update';}";
        body = body + "try{";
        body = body + "var r=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});";
        body = body + "var j=await r.json();";
        body = body + "if(j.ok){window.location.href='/admin/blog';}";
        body = body + "else{msg.style.display='block';msg.className='adm-alert adm-alert--error';msg.textContent=j.error||'Save failed.';btn.disabled=false;btn.textContent='Save Post';}";
        body = body + "}catch(err){msg.style.display='block';msg.className='adm-alert adm-alert--error';msg.textContent='Network error.';btn.disabled=false;btn.textContent='Save Post';}";
        body = body + "});";
        body = body + "</script>";

        return body;
    }

    method blogNew(path) {
        let body = this.blogForm(false, "", "", "", "", "", "draft", "");
        this.page("New Post", body);
    }

    method blogEdit(path) {
        let id = this.queryParam(path, "id");
        if (id == "") { this.redirect("/admin/blog"); return; }

        let db = DB();
        let found = false;
        let title = ""; let slug = ""; let excerpt = ""; let content = ""; let status = ""; let pubAt = "";

        if (db.open()) {
            db.ensurePosts();
            if (sqliteQuery("SELECT id, title, slug, excerpt, content, status, published_at FROM posts WHERE id=" + this.esc(id) + " LIMIT 1")) {
                let rows = sqliteFetchAll();
                if (arrayLength(rows) > 0) {
                    let row = arrayGet(rows, 0);
                    found   = true;
                    id      = arrayGet(row, 0);
                    title   = arrayGet(row, 1);
                    slug    = arrayGet(row, 2);
                    excerpt = arrayGet(row, 3);
                    content = arrayGet(row, 4);
                    status  = arrayGet(row, 5);
                    pubAt   = arrayGet(row, 6);
                }
            }
            db.close();
        }

        if (!found) { this.redirect("/admin/blog"); return; }

        let body = this.blogForm(true, id, title, slug, excerpt, content, status, pubAt);
        this.page("Edit Post", body);
    }

    method blogCreate(path) {
        if (!this.isLoggedIn()) { this.jsonErr(401, "Unauthorized"); return; }
        if (getRequestMethod() != "POST") { this.jsonErr(405, "POST required"); return; }

        let data    = jsonDecode(getRequestBody());
        let title   = this.field(data, "title", "");
        let slug    = this.field(data, "slug", "");
        let excerpt = this.field(data, "excerpt", "");
        let content = this.field(data, "content", "");
        let status  = this.field(data, "status", "draft");

        if (title == "") { this.jsonErr(400, "Title is required"); return; }
        if (slug == "")  { this.jsonErr(400, "Slug is required"); return; }

        let pubAt = "";
        if (status == "published") { pubAt = "{{ now }}"; }

        let db = DB();
        if (!db.open()) { this.jsonErr(500, "Database unavailable"); return; }
        db.ensurePosts();

        let sql = "INSERT INTO posts (title, slug, excerpt, content, status, published_at) VALUES ('" +
            this.esc(title) + "','" + this.esc(slug) + "','" + this.esc(excerpt) + "','" +
            this.esc(content) + "','" + this.esc(status) + "',date('now'))";
        if (status != "published") {
            sql = "INSERT INTO posts (title, slug, excerpt, content, status, published_at) VALUES ('" +
                this.esc(title) + "','" + this.esc(slug) + "','" + this.esc(excerpt) + "','" +
                this.esc(content) + "','" + this.esc(status) + "','')";
        }

        let ok = sqliteExec(sql);
        db.close();

        if (!ok) { this.jsonErr(500, "Failed to save. Slug may already be taken."); return; }
        this.jsonOk();
    }

    method blogUpdate(path) {
        if (!this.isLoggedIn()) { this.jsonErr(401, "Unauthorized"); return; }
        if (getRequestMethod() != "POST") { this.jsonErr(405, "POST required"); return; }

        let data    = jsonDecode(getRequestBody());
        let id      = this.field(data, "id", "");
        let title   = this.field(data, "title", "");
        let slug    = this.field(data, "slug", "");
        let excerpt = this.field(data, "excerpt", "");
        let content = this.field(data, "content", "");
        let status  = this.field(data, "status", "draft");

        if (id == "")    { this.jsonErr(400, "ID is required"); return; }
        if (title == "") { this.jsonErr(400, "Title is required"); return; }
        if (slug == "")  { this.jsonErr(400, "Slug is required"); return; }

        let db = DB();
        if (!db.open()) { this.jsonErr(500, "Database unavailable"); return; }
        db.ensurePosts();

        let pubAtSql = ", published_at=''";
        if (status == "published") { pubAtSql = ", published_at=CASE WHEN published_at='' THEN date('now') ELSE published_at END"; }

        let sql = "UPDATE posts SET title='" + this.esc(title) + "', slug='" + this.esc(slug) +
            "', excerpt='" + this.esc(excerpt) + "', content='" + this.esc(content) +
            "', status='" + this.esc(status) + "'" + pubAtSql + " WHERE id=" + this.esc(id);

        let ok = sqliteExec(sql);
        db.close();

        if (!ok) { this.jsonErr(500, "Failed to update post."); return; }
        this.jsonOk();
    }

    method blogDelete(path) {
        if (getRequestMethod() != "POST") { this.redirect("/admin/blog"); return; }
        let id = this.postParam(getRequestBody(), "id");
        if (id == "") { this.redirect("/admin/blog"); return; }

        let db = DB();
        if (db.open()) {
            db.ensurePosts();
            sqliteExec("DELETE FROM posts WHERE id=" + this.esc(id));
            db.close();
        }
        this.redirect("/admin/blog");
    }

    // ── Settings ──────────────────────────────────────────────────── //

    method settings(path) {
        let currentUser = this.getSetting("admin_username", adminCfg.username);

        let body = "";
        body = body + "<div class=\"adm-page-hdr\"><div><h1>Settings</h1><p class=\"adm-sub\">Update admin credentials</p></div></div>";
        body = body + "<div class=\"adm-card adm-card--form\">";
        body = body + "<form id=\"sForm\" class=\"adm-form\">";
        body = body + "<div class=\"adm-field\"><label>Username</label>";
        body = body + "<input type=\"text\" id=\"sUser\" value=\"" + this.he(currentUser) + "\" required autocomplete=\"username\"></div>";
        body = body + "<div class=\"adm-section-label\">Change Password</div>";
        body = body + "<div class=\"adm-field\"><label>Current Password <span class=\"adm-req\">*</span></label>";
        body = body + "<input type=\"password\" id=\"sCurr\" required autocomplete=\"current-password\" placeholder=\"Enter current password to confirm\"></div>";
        body = body + "<div class=\"adm-field\"><label>New Password <small>leave blank to keep current</small></label>";
        body = body + "<input type=\"password\" id=\"sNew\" autocomplete=\"new-password\" placeholder=\"New password\"></div>";
        body = body + "<div class=\"adm-field\"><label>Confirm New Password</label>";
        body = body + "<input type=\"password\" id=\"sConf\" autocomplete=\"new-password\" placeholder=\"Repeat new password\"></div>";
        body = body + "<div class=\"adm-form-footer\">";
        body = body + "<div id=\"sMsg\" class=\"adm-alert\" style=\"display:none\"></div>";
        body = body + "<button type=\"submit\" id=\"sBtn\" class=\"adm-btn adm-btn--primary\">Save Settings</button>";
        body = body + "</div></form></div>";

        body = body + "<script>";
        body = body + "document.getElementById('sForm').addEventListener('submit',async function(e){";
        body = body + "e.preventDefault();";
        body = body + "var btn=document.getElementById('sBtn');";
        body = body + "var msg=document.getElementById('sMsg');";
        body = body + "var newPass=document.getElementById('sNew').value;";
        body = body + "var confPass=document.getElementById('sConf').value;";
        body = body + "if(newPass && newPass!==confPass){";
        body = body + "msg.style.display='block';msg.className='adm-alert adm-alert--error';msg.textContent='New passwords do not match.';return;}";
        body = body + "btn.disabled=true;btn.textContent='Saving...';";
        body = body + "var data={username:document.getElementById('sUser').value.trim(),current_password:document.getElementById('sCurr').value,new_password:newPass};";
        body = body + "try{";
        body = body + "var r=await fetch('/admin/settings/update',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});";
        body = body + "var j=await r.json();";
        body = body + "if(j.ok){msg.style.display='block';msg.className='adm-alert adm-alert--success';msg.textContent='Settings saved.';btn.disabled=false;btn.textContent='Save Settings';document.getElementById('sCurr').value='';document.getElementById('sNew').value='';document.getElementById('sConf').value='';}";
        body = body + "else{msg.style.display='block';msg.className='adm-alert adm-alert--error';msg.textContent=j.error||'Failed.';btn.disabled=false;btn.textContent='Save Settings';}";
        body = body + "}catch(err){msg.style.display='block';msg.className='adm-alert adm-alert--error';msg.textContent='Network error.';btn.disabled=false;btn.textContent='Save Settings';}";
        body = body + "});";
        body = body + "</script>";

        this.page("Settings", body);
    }

    method settingsUpdate(path) {
        if (!this.isLoggedIn()) { this.jsonErr(401, "Unauthorized"); return; }
        if (getRequestMethod() != "POST") { this.jsonErr(405, "POST required"); return; }

        let data        = jsonDecode(getRequestBody());
        let username    = this.field(data, "username", "");
        let currPass    = this.field(data, "current_password", "");
        let newPass     = this.field(data, "new_password", "");

        if (username == "") { this.jsonErr(400, "Username is required"); return; }
        if (currPass == "") { this.jsonErr(400, "Current password is required"); return; }

        let storedPass = this.getSetting("admin_password", adminCfg.password);
        if (currPass != storedPass) { this.jsonErr(403, "Current password is incorrect"); return; }

        this.setSetting("admin_username", username);
        if (newPass != "") {
            this.setSetting("admin_password", newPass);
        }

        this.jsonOk();
    }

    method dispatch(path) {
        // path has query string stripped by main.melt; use getRequestPath() when query params are needed
        let fullPath = getRequestPath();

        if (path == "/admin/login") {
            this.login(path);
            return;
        }
        if (path == "/admin/logout") {
            this.logout();
            return;
        }
        if (!this.isLoggedIn()) {
            this.redirect("/admin/login");
            return;
        }

        if (path == "/admin" || path == "/admin/releases") {
            this.releases(path);
        } else if (path == "/admin/releases/new") {
            this.releaseNew(path);
        } else if (path == "/admin/releases/edit") {
            this.releaseEdit(fullPath);
        } else if (path == "/admin/releases/create") {
            this.releaseCreate(path);
        } else if (path == "/admin/releases/update") {
            this.releaseUpdate(path);
        } else if (path == "/admin/releases/delete") {
            this.releaseDelete(path);
        } else if (path == "/admin/blog") {
            this.blogList(path);
        } else if (path == "/admin/blog/new") {
            this.blogNew(path);
        } else if (path == "/admin/blog/edit") {
            this.blogEdit(fullPath);
        } else if (path == "/admin/blog/create") {
            this.blogCreate(path);
        } else if (path == "/admin/blog/update") {
            this.blogUpdate(path);
        } else if (path == "/admin/blog/delete") {
            this.blogDelete(path);
        } else if (path == "/admin/settings") {
            this.settings(path);
        } else if (path == "/admin/settings/update") {
            this.settingsUpdate(path);
        } else {
            this.redirect("/admin/releases");
        }
    }
}
