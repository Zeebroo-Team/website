import "../views/layout.melt";

class ContactController {
    method parseFormField(bodyStr, fieldName) {
        let parts = splitString(bodyStr, "&");
        let i = 0;
        while (i < arrayLength(parts)) {
            let part = arrayGet(parts, i);
            let pair = splitString(part, "=");
            if (arrayLength(pair) >= 2 && arrayGet(pair, 0) == fieldName) {
                let val = arrayGet(pair, 1);
                let j = 2;
                while (j < arrayLength(pair)) {
                    val = val + "=" + arrayGet(pair, j);
                    j = j + 1;
                }
                return urlDecode(val);
            }
            i = i + 1;
        }
        return "";
    }

    method index() {
        let reqMethod = getRequestMethod();
        if (reqMethod == "POST") {
            let bodyStr = getRequestBody();
            let name = this.parseFormField(bodyStr, "name");
            if (name == "") { name = "friend"; }
            let view = View();
            view.renderContactSent(name);
            setResponseContentType("text/html; charset=utf-8");
            setResponseBody(view.output);
            setResponseStatus(200);
            return;
        }
        let view = View();
        view.renderContact();
        setResponseContentType("text/html; charset=utf-8");
        setResponseBody(view.output);
        setResponseStatus(200);
    }
}
