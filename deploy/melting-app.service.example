# Example systemd unit — copy to /etc/systemd/system/melting-app.service
# Adjust User, paths, and Melt binary location for your server.
#
#   sudo cp deploy/melting-app.service.example /etc/systemd/system/melting-app.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now melting-app

[Unit]
Description=Zeebroo website (Melt HTTP server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/melting-app
# Path to your built melt binary (install melting-lang on the server)
ExecStart=melt /var/www/melting-app/main.melt
Restart=on-failure
RestartSec=5
Environment=HOME=/var/www/melting-app

# Hardening (optional)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
