import "../config/app.melt";

class ViewData {
    method init() {}
}

class View {
    method init() {
        this.output = "";
    }

    method wrapPage(title, metaDescription, body, activeNav, extraScripts) {
        let layoutData = ViewData();
        layoutData.title = title;
        layoutData.metaDescription = metaDescription;
        layoutData.content = body;
        layoutData.navAbout = "";
        layoutData.navDownload = "";
        layoutData.navBlog = "";
        layoutData.extraScripts = extraScripts;
        if (activeNav == "about") {
            layoutData.navAbout = "is-active";
        }
        if (activeNav == "download") {
            layoutData.navDownload = "is-active";
        }
        if (activeNav == "blog") {
            layoutData.navBlog = "is-active";
        }
        this.output = renderView("views/layout.html", layoutData);
    }

    method renderHome() {
        let body = renderView("views/home_content.html", ViewData());
        let scripts = "<script src=\"/js/hero-animations.js\" defer></script>\n    <script src=\"/js/ascii-hero.js\" defer></script>\n    <script src=\"/js/hero-video.js\" defer></script>";
        this.wrapPage(
            "Zeebroo - Grow your business with one platform",
            "Zeebroo helps you grow your business with stock, POS, accounts, bills, HR, social campaigns, and more - all in one simple platform.",
            body,
            "",
            scripts
        );
    }

    method renderAbout() {
        let body = renderView("views/about_content.html", ViewData());
        this.wrapPage(
            "About - Zeebroo",
            "Learn about Zeebroo - the all-in-one platform for stock, POS, accounts, bills, HR, and marketing.",
            body,
            "about",
            ""
        );
    }

    method renderIndustry(ind) {
        let body = renderView("views/industry_content.html", ind);
        let scripts = "<script src=\"/js/industry.js\" defer></script>";
        this.wrapPage(
            ind.indName + " - Industry Solutions - Zeebroo",
            ind.indMeta,
            body,
            "",
            scripts
        );
    }

    method renderDownload(data) {
        let body = renderView("views/download_content.html", data);
        this.wrapPage(
            "Download - Zeebroo",
            "Download the Zeebroo desktop POS app for Windows, macOS, and Linux, or use the web platform in any browser.",
            body,
            "download",
            ""
        );
    }

    method renderBlogList(data) {
        let body = renderView("views/blog_list.html", data);
        this.wrapPage(
            "Blog - Zeebroo",
            "Insights, product updates, and business tips from the Zeebroo team.",
            body,
            "blog",
            ""
        );
    }

    method renderBlogPost(data) {
        let body = renderView("views/blog_post.html", data);
        this.wrapPage(
            data.postTitle + " - Zeebroo Blog",
            data.postExcerpt,
            body,
            "blog",
            ""
        );
    }

    method renderNotFound(path) {
        let data = ViewData();
        data.path = path;
        this.output = renderView("views/404.html", data);
    }
}
