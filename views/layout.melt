import "../config/app.melt";

class ViewData {
    method init() {}
}

class View {
    method init() {
        this.output = "";
    }

    method renderHome() {
        this.output = renderView("views/home.html", ViewData());
    }

    method renderNotFound(path) {
        let data = ViewData();
        data.path = path;
        this.output = renderView("views/404.html", data);
    }
}
